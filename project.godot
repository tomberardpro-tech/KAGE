; Engine configuration file.
; KAGE — jeu d'infiltration ninja en 3D (Godot 4, export web pour itch.io)

config_version=5

[application]

config/name="KAGE"
config/description="Infiltration ninja dans un château japonais, de nuit, sous la lune."
run/main_scene="res://scenes/ui/menu.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[autoload]

Transition="*res://scripts/transition.gd"
Reglages="*res://scripts/reglages.gd"
Sauvegarde="*res://scripts/sauvegarde.gd"
Capture="*res://scripts/tools/capture.gd"
Sons="*res://scripts/sons.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://assets/ui/kage_theme.tres"

