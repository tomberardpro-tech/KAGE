[node name="ApercuCharte" type="Panel"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("Fond")
script = ExtResource("1_ap")

[node name="Marges" type="MarginContainer" parent="."]
