[sub_resource type="Shader" id="Shader_a13fi"]
code = "
shader_type spatial;
uniform sampler2D tissu : source_color, filter_linear_mipmap;
void fragment() {
	vec3 t = texture(tissu, UV).rgb;
	float l = dot(t, vec3(0.333));
	ALBEDO = vec3(0.8, 0.74, 0.62) * (0.45 + 0.9 * l);
	ROUGHNESS = 0.9;
}
"

